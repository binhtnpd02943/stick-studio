# Copy to .env and fill in. Never commit .env. Values below are placeholders only.

# Database. Leave DATABASE_URL unset to use PGlite (single process; `npm run dev` only).
# `npm run api` and `npm run worker` need Postgres: run `npm run infra:up`, then uncomment.
# DATABASE_URL=postgres://stick:stick@127.0.0.1:5432/stick
STICK_PGLITE_DIR=out/.pglite

# Redis (BullMQ queue, rate limits). Started by `npm run infra:up`.
REDIS_URL=redis://127.0.0.1:6379

STICK_STORAGE_DIR=out/storage
STICK_CACHE_DIR=out/.cache

# Serve the built web app (`npm run build -w @stick/web`) from the API. Unset = API only.
# STICK_WEB_DIR=apps/web/dist

HOST=127.0.0.1
PORT=3000

# Signs asset URLs. Required for api and dev, at least 32 characters.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
STICK_URL_SIGNING_KEY=

# 1 = FakeLlm/FakeTts, no ANTHROPIC_API_KEY needed.
STICK_FAKE=0

# Required for worker and dev unless STICK_FAKE=1.
ANTHROPIC_API_KEY=
STICK_LLM_MODEL=claude-sonnet-5-5

# Budget defaults, used when a workspace sets no cap (USD).
STICK_MAX_COST_USD=1
STICK_MAX_COST_PER_DAY_USD=10

# Required by `npm run seed`: the owner's password, at least 12 characters.
# STICK_SEED_PASSWORD=
